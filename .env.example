# =====================================================================
# CiteGuard AI - Environment Configuration Template
# =====================================================================

# --- LLM API Keys (Optional: CiteGuard defaults to deterministic NLI heuristic if omitted) ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Live Email Dispatch (SMTP Configuration) ---
# When configured, CiteGuard AI delivers real 6-digit verification codes to user inboxes.
# If omitted, CiteGuard runs in Demo Mode (displays the verification OTP code on screen).

# Example 1: Gmail (Use a Google 16-character App Password, NOT your regular password)
# 1. Enable 2-Step Verification in Google Account Settings
# 2. Go to Security -> App Passwords -> Generate for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=CiteGuard AI <your_email@gmail.com>
SMTP_USE_SSL=false

# Example 2: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM=CiteGuard AI <verify@yourverifieddomain.com>
# SMTP_USE_SSL=false

# Example 3: Brevo (formerly Sendinblue)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login
# SMTP_PASSWORD=your_brevo_smtp_key
# SMTP_FROM=CiteGuard AI <verify@yourdomain.com>
# SMTP_USE_SSL=false
